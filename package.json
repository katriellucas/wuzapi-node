{
  "name": "wuzapi",
  "version": "1.10.0",
  "packageManager": "bun@1.3.8",
  "description": "TypeScript client library for WuzAPI WhatsApp API",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "bun run clean",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build",
    "release:patch": "bun pm version patch && bun publish",
    "release:minor": "bun pm version minor && bun publish",
    "release:major": "bun pm version major && bun publish",
    "release": "bun publish",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "whatsapp",
    "api",
    "client",
    "typescript",
    "wuzapi"
  ],
  "author": "Gus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gusnips/wuzapi-node.git"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "debug": "^4.4.3"
  }
}